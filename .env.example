PORT=3000
HOST=0.0.0.0
AUTH_DIR=./auth_info
DATA_DIR=./data
DEFAULT_COUNTRY=91
LOG_LEVEL=info

# Set a long random value in production. API routes require Bearer auth when set.
CONNECTOR_API_TOKEN=replace-with-a-long-random-token

# OTP controls
OTP_TTL_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=replace-with-a-long-random-secret

# Set true only if you want the service to start WhatsApp connection on boot.
AUTO_CONNECT=false
